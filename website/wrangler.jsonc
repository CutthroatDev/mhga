// Cloudflare Workers configuration (static assets).
// Deploy with `npm run deploy`, or connect the repo in the Cloudflare dashboard
// with build command `npm run build` and output directory `dist`.
{
  "name": "halloween-site",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
