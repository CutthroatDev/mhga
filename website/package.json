{
  "name": "halloween-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --local",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "wrangler types --include-runtime=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seeds/local-dev.sql",
    "db:query:local": "wrangler d1 execute DB --local --command",
    "ingest:local": "node scripts/ingest-local.mjs",
    "db:migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "miniflare": "4.20260114.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "5.0.1",
    "wrangler": "4.59.2"
  }
}
