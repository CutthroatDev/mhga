---
/**
 * Layout for the LOCAL-ONLY admin. Separate from the public BaseLayout: no public header,
 * footer, theme toggle, or decorations. Pages that use it must also run the access guard
 * and set `export const prerender = false`.
 */
// CSS is imported as RAW TEXT and inlined below, on purpose. Importing it as a normal
// stylesheet would put admin CSS in the bundler's graph: it would split the public site's CSS
// into extra chunks and publish an admin stylesheet as a public static file.
import tokensCss from '@/styles/tokens.css?raw';
import themeCss from '@/styles/theme.css?raw';
import adminCss from '@/admin/styles/admin.css?raw';
import { siteConfig } from '@/config/site';

interface Props {
  title: string;
  active?: 'dashboard' | 'pending' | 'approved' | 'rejected' | 'all';
}

const { title, active } = Astro.props;

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin' },
  { key: 'pending', label: 'Pending', href: '/admin/products/pending' },
  { key: 'approved', label: 'Approved', href: '/admin/products/approved' },
  { key: 'rejected', label: 'Rejected', href: '/admin/products/rejected' },
  { key: 'all', label: 'All products', href: '/admin/products' },
] as const;
---

<!doctype html>
<html lang="en" data-halloween-theme="cute">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Admin · {siteConfig.name}</title>
    <style is:inline set:html={tokensCss + themeCss + adminCss}></style>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="admin-header band">
      <div class="admin-bar">
        <a class="admin-brand" href="/admin">
          {siteConfig.name} <small>Admin</small>
        </a>
        <nav class="admin-nav" aria-label="Admin">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="admin-public-link" href="/">View public site</a>
      </div>
    </header>

    <div class="admin-banner" role="note">
      <strong>LOCAL DEVELOPMENT ONLY.</strong> Not authenticated. This admin exists only on a
      local dev server and is disabled in every production build.
    </div>

    <main id="main" class="admin-main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
