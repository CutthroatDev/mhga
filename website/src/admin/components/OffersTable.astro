---
// Read-only view of a product's retailer offers. (No affiliate data is shown or editable.)
import type { AdminOfferView } from '@/server/domain/admin';
import { AVAILABILITY_LABELS, formatCents, formatDate } from '@/admin/format';
import { OFFER_FRESH_DAYS, OFFER_USABLE_DAYS } from '@/server/domain/offer-freshness';

// Wording for the derived freshness (the policy itself lives in domain/offer-freshness.ts).
const FRESHNESS_LABELS = {
  fresh: `Fresh (checked within ${OFFER_FRESH_DAYS} days)`,
  stale: `Stale: refresh due (used publicly until ${OFFER_USABLE_DAYS} days)`,
  expired: `Expired: not used publicly (older than ${OFFER_USABLE_DAYS} days)`,
} as const;

interface Props {
  offers: AdminOfferView[];
}

const { offers } = Astro.props;
---

<div class="table-wrap offers">
  {
    offers.length === 0 ? (
      <p class="empty-queue">No offers yet. A product needs an eligible offer (active retailer, http(s) link, not discontinued, checked within the last {OFFER_USABLE_DAYS} days) to be public.</p>
    ) : (
      <table class="queue">
        <thead>
          <tr>
            <th scope="col">Retailer</th>
            <th scope="col">Retailer product URL</th>
            <th scope="col">Price</th>
            <th scope="col">Currency</th>
            <th scope="col">Availability</th>
            <th scope="col">Preferred</th>
            <th scope="col">Last checked</th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => (
            <tr>
              <td class="name" data-label="Retailer">
                <strong>{offer.retailerName}</strong>
                {!offer.retailerIsActive && <small>Inactive retailer: not used publicly</small>}
                {offer.sourceId && (
                  <small class="muted">
                    Ingested from <code>{offer.sourceId}</code>
                    {offer.sourceTitle && <> · retailer title: “{offer.sourceTitle}”</>}
                  </small>
                )}
              </td>
              <td class="url" data-label="URL">
                <a href={offer.productUrl} target="_blank" rel="noopener noreferrer">
                  {offer.productUrl}<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </td>
              <td class="num" data-label="Price">{formatCents(offer.priceCents, offer.currency)}</td>
              <td data-label="Currency">{offer.currency}</td>
              <td data-label="Availability">{AVAILABILITY_LABELS[offer.availability] ?? offer.availability}</td>
              <td data-label="Preferred">
                {offer.isPrimary ? <span class="tag tag--primary">Primary</span> : <span class="muted">No</span>}
              </td>
              <td class="num" data-label="Last checked">
                {offer.lastCheckedAt ? formatDate(offer.lastCheckedAt) : 'Never'}
                <br />
                <small class="muted">
                  {offer.lastCheckedAt ? FRESHNESS_LABELS[offer.freshness] : `Never checked: not used publicly`}
                </small>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</div>
