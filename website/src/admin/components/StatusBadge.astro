---
// Status is shown with a text label AND a distinct icon shape, in addition to color, so it
// never depends on color alone.
import type { ProductReviewStatus } from '@/types';

interface Props {
  status: ProductReviewStatus;
}

const { status } = Astro.props;
const labels: Record<ProductReviewStatus, string> = {
  pending: 'Pending',
  approved: 'Approved',
  rejected: 'Rejected',
};
---

<span class={`status status--${status}`}>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {
      status === 'pending' && (
        <>
          <circle cx="8" cy="8" r="6" />
          <path d="M8 4.5V8l2.5 1.5" />
        </>
      )
    }
    {status === 'approved' && <path d="M3 8.5l3.2 3.2L13 4.8" />}
    {status === 'rejected' && <path d="M4 4l8 8M12 4l-8 8" />}
  </svg>
  {labels[status]}
</span>
