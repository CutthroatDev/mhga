---
// On-demand: shows live products from D1, so an approval/removal is visible immediately.
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ProductDetail from '@/components/products/ProductDetail.astro';
import ProductShelf from '@/components/products/ProductShelf.astro';
import { getPublicCatalog } from '@/data-access';

const catalog = getPublicCatalog(Astro);
const item = Astro.params.slug ? await catalog.getProductBySlug('costumes', Astro.params.slug) : undefined;

// A pending, rejected, ineligible, wrong-section, or unknown slug all look the same: the
// site's normal 404 (no body, so Astro renders src/pages/404.astro). Never say why.
if (!item) return new Response(null, { status: 404 });

const related = await catalog.getRelatedProducts(item);
---

<BaseLayout title={item.product.name} description={item.product.summary}>
  <Section>
    <div class="crumbs">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Costumes', href: '/costumes' },
          { label: 'Products', href: '/costumes/products' },
          { label: item.product.name },
        ]}
      />
    </div>
    <ProductDetail item={item} />
  </Section>

  {
    related.length > 0 && (
      <ProductShelf
        id="related-heading"
        variant="muted"
        title="More costumes"
        items={related}
        viewAllHref="/costumes/products"
      />
    )
  }
</BaseLayout>

<style>
  .crumbs {
    margin-bottom: var(--space-4);
  }
</style>
