---
// On-demand: shows live products from D1, so an approval/removal is visible immediately.
export const prerender = false;

import CategoryPage from '@/components/categories/CategoryPage.astro';
import { getNavChildren } from '@/config/site';
import { getPublicCatalog } from '@/data-access';

const items = await getPublicCatalog(Astro).getProducts({ section: 'costumes' });
---

<CategoryPage
  eyebrow="Costumes"
  title="All costume products"
  description="Every approved Halloween costume in one place."
  tone="costumes"
  items={items}
  subNavItems={getNavChildren('/costumes')}
  subNavLabel="Costumes"
/>
