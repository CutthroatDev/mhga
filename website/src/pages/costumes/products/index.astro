---
import CategoryPage from '@/components/categories/CategoryPage.astro';
import { getNavChildren } from '@/config/site';
import { getApprovedProductListItems } from '@/data-access';

const items = await getApprovedProductListItems({ section: 'costumes' });
---

<CategoryPage
  eyebrow="Costumes"
  title="All costume products"
  description="Every approved Halloween costume in one place."
  tone="costumes"
  items={items}
  subNavItems={getNavChildren('/costumes')}
  subNavLabel="Costumes"
/>
