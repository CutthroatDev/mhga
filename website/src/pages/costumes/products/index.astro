---
import CategoryPage from '@/components/categories/CategoryPage.astro';
import { getNavChildren } from '@/config/site';
import { getApprovedProducts } from '@/data-access';

const products = await getApprovedProducts({ section: 'costumes' });
---

<CategoryPage
  title="Costume Products"
  description="All approved Halloween costume products."
  products={products}
  subNavItems={getNavChildren('/costumes')}
/>
