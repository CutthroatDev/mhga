---
import CategoryPage from '@/components/categories/CategoryPage.astro';
import { getNavChildren } from '@/config/site';
import { getApprovedProductListItems, getCategoryBySlug } from '@/data-access';

const category = await getCategoryBySlug('decorations', 'indoor');
const items = await getApprovedProductListItems({ section: 'decorations', categorySlug: 'indoor' });
---

<CategoryPage
  eyebrow="Decorations"
  title={category?.name ?? 'Indoor Decorations'}
  description={category?.description}
  tone="indoor"
  items={items}
  subNavItems={getNavChildren('/decorations')}
  subNavLabel="Decorations"
  emptyMessage="Indoor picks are being reviewed. Check back soon."
/>
