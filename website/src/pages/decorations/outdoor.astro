---
// On-demand: shows live products from D1, so an approval/removal is visible immediately.
export const prerender = false;

import CategoryPage from '@/components/categories/CategoryPage.astro';
import { getNavChildren } from '@/config/site';
import { getPublicCatalog } from '@/data-access';

const catalog = getPublicCatalog(Astro);
const [category, items] = await Promise.all([
  catalog.getCategory('decorations', 'outdoor'),
  catalog.getProducts({ section: 'decorations', categorySlug: 'outdoor' }),
]);
---

<CategoryPage
  eyebrow="Decorations"
  title={category?.name ?? 'Outdoor Decorations'}
  description={category?.description}
  tone="outdoor"
  items={items}
  subNavItems={getNavChildren('/decorations')}
  subNavLabel="Decorations"
  emptyMessage="Outdoor picks are being reviewed. Check back soon."
/>
