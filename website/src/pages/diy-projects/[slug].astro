---
// On-demand only because its related products are live from D1 (project content is static).
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import DIYProjectDetail from '@/components/diy/DIYProjectDetail.astro';
import DIYProjectGrid from '@/components/diy/DIYProjectGrid.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import ProductShelf from '@/components/products/ProductShelf.astro';
import {
  getPublicCatalog,
  getPublishedDIYProjectBySlug,
  getRelatedDIYProjects,
} from '@/data-access';

const project = Astro.params.slug ? await getPublishedDIYProjectBySlug(Astro.params.slug) : undefined;
if (!project) return new Response(null, { status: 404 });

// Hidden products (pending, rejected, ineligible) are skipped by the public catalog.
const [relatedProducts, relatedProjects] = await Promise.all([
  getPublicCatalog(Astro).getProductsBySlugs(project.relatedProductSlugs ?? []),
  getRelatedDIYProjects(project),
]);
---

<BaseLayout title={project.title} description={project.summary}>
  <Section>
    <div class="crumbs">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'DIY Projects', href: '/diy-projects' },
          { label: project.title },
        ]}
      />
    </div>
    <DIYProjectDetail project={project} />
  </Section>

  {
    relatedProducts.length > 0 && (
      <ProductShelf
        id="related-products-heading"
        variant="muted"
        eyebrow="Shop the project"
        title="Related products"
        items={relatedProducts}
      />
    )
  }

  {
    relatedProjects.length > 0 && (
      <Section labelledby="related-projects-heading">
        <SectionHeading id="related-projects-heading" title="More projects" />
        <DIYProjectGrid projects={relatedProjects} />
      </Section>
    )
  }
</BaseLayout>

<style>
  .crumbs {
    margin-bottom: var(--space-4);
  }
</style>
