---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Section from '@/components/layout/Section.astro';
import DIYProjectGrid from '@/components/diy/DIYProjectGrid.astro';
import { getPublishedDIYProjects } from '@/data-access';

const projects = await getPublishedDIYProjects();
---

<BaseLayout title="DIY Projects">
  <PageHeader
    title="DIY Projects"
    description="Make your own Halloween decorations and costumes."
  />
  <Section>
    <DIYProjectGrid projects={projects} />
  </Section>
</BaseLayout>
