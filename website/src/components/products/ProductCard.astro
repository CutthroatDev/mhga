---
import type { ProductListItem } from '@/types';
import { formatPrice } from '@/utils/format';
import { productPath } from '@/utils/routes';
import Badge from '@/components/ui/Badge.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';

interface Props {
  item: ProductListItem;
}

const { product, retailer, categories } = Astro.props.item;
const price = formatPrice(product.price);
const category = categories[0]?.name;
---

<article class="card">
  <div class="media">
    {
      product.imageUrl ? (
        <img src={product.imageUrl} alt={product.imageAlt ?? ''} loading="lazy" />
      ) : (
        <ImagePlaceholder ratio="1 / 1" />
      )
    }
  </div>
  <div class="body">
    {category && <p class="category">{category}</p>}
    <h3 class="name">
      <a href={productPath(product.section, product.slug)}>{product.name}</a>
    </h3>
    <p class="summary">{product.summary}</p>
    {
      product.badges && product.badges.length > 0 && (
        <p class="badges">
          {product.badges.map((badge) => <Badge>{badge}</Badge>)}
        </p>
      )
    }
    <p class="meta">
      {retailer && <span class="retailer">{retailer.name}</span>}
      {price && <span class="price">{price}</span>}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Product images are the focus: full-bleed, fixed ratio so nothing shifts on load. */
  .media img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .category {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .name {
    font-size: var(--text-lg);
  }

  /* The title link covers the whole card, so there is one focus stop per card. */
  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .name a:hover {
    color: var(--color-accent-hover);
  }

  .name a:focus-visible {
    outline: none;
  }

  .name a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .retailer {
    color: var(--color-text-muted);
  }

  .price {
    margin-left: auto;
    font-size: var(--text-md);
    font-weight: 700;
  }
</style>
