---
import type { DIYProject } from '@/types';
import EmptyState from '@/components/ui/EmptyState.astro';
import DIYProjectCard from './DIYProjectCard.astro';

interface Props {
  projects: DIYProject[];
  emptyTitle?: string;
  emptyMessage?: string;
}

const { projects, emptyTitle, emptyMessage } = Astro.props;
---

{
  projects.length > 0 ? (
    <ul class="grid" role="list">
      {projects.map((project) => (
        <li>
          <DIYProjectCard project={project} />
        </li>
      ))}
    </ul>
  ) : (
    <EmptyState
      title={emptyTitle ?? 'Projects coming soon'}
      message={emptyMessage ?? 'New projects are on the workbench. Check back soon.'}
    />
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    }
  }
</style>
