---
// DIY project layout: hero image, intro, materials, instructions. Related products and
// projects are rendered by the page so this component stays focused on one project.
import type { DIYProject } from '@/types';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';

interface Props {
  project: DIYProject;
}

const { project } = Astro.props;
---

<article class="project">
  <header class="intro">
    <p class="eyebrow">DIY project</p>
    <h1>{project.title}</h1>
    <p class="summary">{project.summary}</p>
    <dl class="facts">
      <div>
        <dt>Difficulty</dt>
        <dd class="difficulty">{project.difficulty}</dd>
      </div>
      {
        project.estimatedTime && (
          <div>
            <dt>Time</dt>
            <dd>{project.estimatedTime}</dd>
          </div>
        )
      }
    </dl>
  </header>

  <div class="hero">
    {
      project.imageUrl ? (
        <img src={project.imageUrl} alt={project.imageAlt ?? project.title} />
      ) : (
        <ImagePlaceholder ratio="16 / 9" />
      )
    }
  </div>

  <div class="body">
    <section class="materials" aria-labelledby="materials-heading">
      <h2 id="materials-heading">What you'll need</h2>
      <ul>
        {project.materials.map((material) => <li>{material}</li>)}
      </ul>
    </section>

    <section class="steps" aria-labelledby="steps-heading">
      <h2 id="steps-heading">Instructions</h2>
      <ol>
        {project.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: var(--space-5);
  }

  .intro {
    max-width: var(--reading-width);
  }

  .summary {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .facts dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
  }

  .difficulty {
    text-transform: capitalize;
  }

  .hero {
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      align-items: start;
    }

    .materials {
      position: sticky;
      top: var(--space-4);
    }
  }

  .materials {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
  }

  .materials ul {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
  }

  /* Large serif numerals make the instructions feel editorial. */
  .steps ol {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding-left: 3.25rem;
    counter-increment: step;
    font-size: var(--text-lg);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: -0.15rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }
</style>
