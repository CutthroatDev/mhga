---
// Editorial card: a wider image and a serif title. Visually related to product cards,
// but more inspirational than transactional.
import type { DIYProject } from '@/types';
import { diyProjectPath } from '@/utils/routes';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';

interface Props {
  project: DIYProject;
}

const { project } = Astro.props;
---

<article class="card">
  <div class="media">
    {
      project.imageUrl ? (
        <img src={project.imageUrl} alt={project.imageAlt ?? ''} loading="lazy" />
      ) : (
        <ImagePlaceholder ratio="3 / 2" />
      )
    }
  </div>
  <div class="body">
    <p class="meta">
      <span class="difficulty">{project.difficulty}</span>
      {project.estimatedTime && <span>{project.estimatedTime}</span>}
    </p>
    <h3 class="title">
      <a href={diyProjectPath(project.slug)}>{project.title}</a>
    </h3>
    <p class="summary">{project.summary}</p>
    <p class="more" aria-hidden="true">Read the project &rarr;</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .title {
    font-size: var(--text-xl);
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .title a:hover {
    color: var(--color-accent-hover);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .summary {
    color: var(--color-text-muted);
  }

  .more {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 700;
    color: var(--color-accent-text);
  }
</style>
