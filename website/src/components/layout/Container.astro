---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['container', className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
