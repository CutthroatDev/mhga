---
import type { NavItem } from '@/types';
import { isActivePath } from '@/utils/routes';

interface Props {
  items: NavItem[];
  label?: string;
}

const { items, label = 'Section' } = Astro.props;
const currentPath = Astro.url.pathname;
---

{
  items.length > 0 && (
    <nav aria-label={label}>
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActivePath(currentPath, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<!-- Designed for dark bands (PageHeader). -->
<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--band-line);
    border-radius: var(--radius-pill);
    background: var(--band-surface);
    color: var(--band-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  a:hover {
    border-color: var(--band-accent);
    color: var(--band-text);
  }

  a[aria-current='page'] {
    border-color: var(--band-accent);
    background: var(--band-accent);
    color: var(--band-accent-contrast);
  }
</style>
