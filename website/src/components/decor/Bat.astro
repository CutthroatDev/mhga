---
// Decorative only. A bat hanging from a thread. Both variants share the wing shape;
// scary is darker with glowing eyes, cute has a smile and blush.
---

<svg class="only-cute" viewBox="0 0 64 72" focusable="false">
  <line class="thread" x1="32" y1="0" x2="32" y2="24"></line>
  <g class="wing"><path d="M28 36C22 28 12 26 2 30c4 2 6 5 6 9 3-2 6-2 8 1 3-2 6-1 8 2z"></path></g>
  <g class="wing" transform="translate(64 0) scale(-1 1)">
    <path d="M28 36C22 28 12 26 2 30c4 2 6 5 6 9 3-2 6-2 8 1 3-2 6-1 8 2z"></path>
  </g>
  <path class="wing" d="M26 30l1-9 5 5 5-5 1 9z"></path>
  <ellipse class="wing" cx="32" cy="40" rx="7" ry="10"></ellipse>
  <circle class="ink" cx="29.3" cy="38" r="1.6"></circle>
  <circle class="ink" cx="34.7" cy="38" r="1.6"></circle>
  <path class="smile" d="M29.5 42q2.5 2.5 5 0"></path>
  <circle class="blush" cx="27" cy="41" r="1.6"></circle>
  <circle class="blush" cx="37" cy="41" r="1.6"></circle>
</svg>

<svg class="only-scary" viewBox="0 0 64 72" focusable="false">
  <line class="thread" x1="32" y1="0" x2="32" y2="24"></line>
  <g class="wing"><path d="M28 36C20 26 10 24 0 30l7 3-4 5 8-1 2 6 5-4 4 5z"></path></g>
  <g class="wing" transform="translate(64 0) scale(-1 1)">
    <path d="M28 36C20 26 10 24 0 30l7 3-4 5 8-1 2 6 5-4 4 5z"></path>
  </g>
  <path class="wing" d="M26 30l0-10 5 6 5-6 1 10z"></path>
  <ellipse class="wing" cx="32" cy="40" rx="6.5" ry="10"></ellipse>
  <circle class="eye" cx="29.3" cy="38" r="1.5"></circle>
  <circle class="eye" cx="34.7" cy="38" r="1.5"></circle>
</svg>

<style>
  .thread {
    stroke: var(--band-muted);
    stroke-opacity: 0.6;
    stroke-width: 1;
  }
  .wing,
  .wing path {
    fill: var(--deco-bat);
  }
  .only-scary .wing,
  .only-scary .wing path {
    stroke: var(--band-muted);
    stroke-opacity: 0.35;
    stroke-width: 0.75;
  }
  .ink {
    fill: var(--deco-ink);
  }
  .eye {
    fill: var(--deco-eye);
  }
  .blush {
    fill: var(--deco-blush);
    fill-opacity: 0.8;
  }
  .smile {
    fill: none;
    stroke: var(--deco-ink);
    stroke-width: 1.2;
    stroke-linecap: round;
  }
</style>
