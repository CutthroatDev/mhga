---
// Decorative only. Renders both variants; CSS shows the one for the active theme.
// To use real artwork later, replace the <svg> elements or swap in <img> files from
// src/assets/decorations/{cute,scary}/.
---

<svg class="only-cute" viewBox="0 0 80 96" focusable="false">
  <path
    class="body"
    d="M10 40C10 20 22 6 40 6s30 14 30 34v46c0 3-3 4-5 2l-7-7-8 8-8-8-8 8-8-8-7 7c-5 1-9-1-9-2z"
  ></path>
  <g class="blink">
    <circle class="ink" cx="30" cy="38" r="4"></circle>
    <circle class="ink" cx="50" cy="38" r="4"></circle>
  </g>
  <circle class="blush" cx="23" cy="48" r="4.5"></circle>
  <circle class="blush" cx="57" cy="48" r="4.5"></circle>
  <path class="smile" d="M33 49q7 7 14 0"></path>
</svg>

<svg class="only-scary" viewBox="0 0 70 120" focusable="false">
  <path
    class="body"
    d="M35 4C18 4 8 20 8 42v58l9 10 9-10 9 10 9-10 9 10 9-10V42C62 20 52 4 35 4z"
  ></path>
  <g class="blink">
    <ellipse class="ink" cx="25" cy="42" rx="5" ry="8"></ellipse>
    <ellipse class="ink" cx="45" cy="42" rx="5" ry="8"></ellipse>
  </g>
  <ellipse class="ink" cx="35" cy="66" rx="6" ry="10"></ellipse>
</svg>

<style>
  .body {
    fill: var(--deco-ghost);
    fill-opacity: 0.92;
  }
  .only-scary .body {
    fill-opacity: 0.8;
  }
  .ink {
    fill: var(--deco-ink);
  }
  .blush {
    fill: var(--deco-blush);
    fill-opacity: 0.75;
  }
  .smile {
    fill: none;
    stroke: var(--deco-ink);
    stroke-width: 3;
    stroke-linecap: round;
  }
</style>
