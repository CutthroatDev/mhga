---
// Decorative only. A pair of eyes peeking out. Meant to be placed so the bottom edge
// is hidden behind or beyond a section edge. They blink rarely (motion-safe only).
---

<svg class="only-cute" viewBox="0 0 72 40" focusable="false">
  <g class="blink">
    <ellipse class="white" cx="20" cy="22" rx="13" ry="14"></ellipse>
    <ellipse class="white" cx="52" cy="22" rx="13" ry="14"></ellipse>
    <circle class="pupil" cx="22" cy="24" r="6.5"></circle>
    <circle class="pupil" cx="50" cy="24" r="6.5"></circle>
    <circle class="white" cx="24.5" cy="21.5" r="2.2"></circle>
    <circle class="white" cx="52.5" cy="21.5" r="2.2"></circle>
  </g>
</svg>

<svg class="only-scary" viewBox="0 0 72 40" focusable="false">
  <g class="blink">
    <ellipse class="glow" cx="18" cy="22" rx="16" ry="12"></ellipse>
    <ellipse class="glow" cx="54" cy="22" rx="16" ry="12"></ellipse>
    <path class="slit" d="M6 20c6-6 14-6 20 2-6 4-14 4-20-2z"></path>
    <path class="slit" d="M66 20c-6-6-14-6-20 2 6 4 14 4 20-2z"></path>
  </g>
</svg>

<style>
  .white {
    fill: var(--deco-eye);
  }
  .pupil {
    fill: var(--deco-pupil);
  }
  .glow {
    fill: var(--deco-eye);
    fill-opacity: 0.12;
  }
  .slit {
    fill: var(--deco-eye);
  }
</style>
